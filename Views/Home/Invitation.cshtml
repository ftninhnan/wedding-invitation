<!-- Welcome Section -->
<section
    class="container text-center py-5 animate-section">

    <div class="couple-name">

        <div>Haziq</div>

        <div class="and-symbol">&</div>

        <div>Fatnin</div>

    </div>

    <p>Assalamualaikum W.B.T</p>

    <p>
        Dengan penuh kesyukuran,
        kami menjemput anda ke majlis
        perkahwinan kami.
    </p>

</section>

<div class="section-divider"></div>

<section class="container text-center animate-section">

    <h2>بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيم</h2>

    <p class="quote">
        "Dan di antara tanda-tanda kebesaran-Nya,
        Dia menciptakan untukmu pasangan hidup
        supaya kamu merasa tenteram kepadanya."
    </p>

    <small>
        Surah Ar-Rum : 21
    </small>

</section>

<div class="section-divider"></div>

<!-- Couple Section -->
<section class="container py-5 animate-section">
<div class="glass-card">
    <h2 class="text-center mb-5">
        Pengantin
    </h2>


    <div class="row">
        <div class="col-md-6 text-center">
            <img src="/images/groom.jpg" class="couple-photo" />
                <h3 class="mt-3">
                    Muhammad Haziq
                </h3>

                <p>
                    Putera kepada
                <br />
                    Encik Nudin
                <br />
                    dan
                <br />
                    Puan Ani Hanisah
                </p>
        </div>

        <div class="col-md-6 text-center">
            <img src="/images/bride.jpg" class="couple-photo" />
                <h3 class="mt-3">
                    Fatnin Hanan
                </h3>


                <p>
                    Puteri kepada
                <br />
                    Allahyarham Abdul Mutalif
                <br />
                    dan
                <br />
                    Hajjah Normala
                </p>
        </div>
    </div>
</div>
</section>

<div class="section-divider"></div>

<!--Countdown Section -->
<section class="container text-center py-5 animate-section">

    <h2 class="mb-4">
        Countdown To Our Big Day
    </h2>

    <div class="countdown-container">

        <div class="countdown-card">
            <div id="days" class="countdown-number">0</div>
            <div class="countdown-label">Days</div>
        </div>

        <div class="countdown-card">
            <div id="hours" class="countdown-number">0</div>
            <div class="countdown-label">Hours</div>
        </div>

        <div class="countdown-card">
            <div id="minutes" class="countdown-number">0</div>
            <div class="countdown-label">Minutes</div>
        </div>

        <div class="countdown-card">
            <div id="seconds" class="countdown-number">0</div>
            <div class="countdown-label">Seconds</div>
        </div>

    </div>

</section>

<div class="section-divider"></div>

<!-- Event Details -->
<section
    class="container py-5 text-center animate-section">

    <h2>Maklumat Majlis</h2>

    <div class="event-card">

    <h4>📅 Tarikh</h4>
        <p>3 Januari 2027</p>

    <h4>🕒 Masa</h4>
        <p>11:00 AM - 4:00 PM</p>
    
    <h4>📍 Lokasi</h4>
        <p>Bizmilla Wedding Hall Gamuda Garden</p>
    </div>

</section>

<div class="section-divider"></div>

<!--Our Story -->

<section class="container animate-section">

    <div class="glass-card">

        <h2>Our Story</h2>

        <div class="timeline">

            <div class="timeline-item">

                <div class="timeline-time">
                    2022
                </div>

                <div class="timeline-event">
                    First Meet
                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-time">
                    2023
                </div>

                <div class="timeline-event">
                    Started Our Relationship
                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-time">
                    2026
                </div>

                <div class="timeline-event">
                    Tunang
                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-time">
                    2027
                </div>

                <div class="timeline-event">
                    Walimatulurus
                </div>

            </div>

        </div>

    </div>

</section>

<div class="section-divider"></div>

<p class="mini-quote">
    “Together is our favourite place to be.”
</p>

<!--Gallery Carounsel -->
<section class="container animate-section">

    <h2 class="text-center mb-4">
        Galeri
    </h2>

    <div id="galleryCarousel"
         class="carousel slide carousel-fade"
         data-bs-ride="carousel"
         data-bs-interval="4000">

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="/images/cincin1.jpg"
                    class="d-block w-100 gallery-image"
                    alt="Gallery Image 1">
            </div>

            <div class="carousel-item">
                <img src="/images/tunang1.jpg"
                    class="d-block w-100 gallery-image"
                    alt="Gallery Image 1">
            </div>

            <div class="carousel-item">
                <img src="/images/tunang2.jpg"
                    class="d-block w-100 gallery-image"
                    alt="Gallery Image 1">
            </div>

            <div class="carousel-item">
                <img src="/images/tunang3.jpg"
                    class="d-block w-100 gallery-image"
                    alt="Gallery Image 1">
            </div>

            <div class="carousel-item">
                <img src="/images/tunang4.jpg"
                    class="d-block w-100 gallery-image"
                    alt="Gallery Image 1">
            </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#galleryCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#galleryCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

        </button>

    </div>

</section>

<!-- Timeline Section -->

<div class="section-divider"></div>

<section class="container animate-section">

    <div class="glass-card">

        <h2 class="text-center">
            Atur Cara Majlis
        </h2>

        <div class="timeline">

            <div class="timeline-item">

                <div class="timeline-time">
